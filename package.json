    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next-auth": "^4.24.8",
    "@prisma/client": "^5.22.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "redis": "^4.7.0",
    "bull": "^4.16.3",
    "zustand": "^5.0.1",
    "react-hook-form": "^7.53.2",
    "zod": "^3.23.8",
    "@hookform/resolvers": "^3.9.1",
    "bcryptjs": "^2.4.3",
    "multer": "^1.4.5-lts.1",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
