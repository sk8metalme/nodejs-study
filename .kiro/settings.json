{
  "trustedCommands": [
    // --- PHP ---
    "php -v",
    "php artisan *",
    "composer install",
    "composer update",
    "composer dump-autoload",
    "phpunit *",
    // --- Perl ---
    "perl -c *",
    "perl -Ilib *",
    "cpanm *",
    "prove *",
    // --- Java ---
    "javac *",
    "java *",
    "mvn clean",
    "mvn package",
    "mvn test",
    "gradle build",
    "gradle test",
    // --- Node.js ---
    "node *",
    "npm install",
    "npm run *",
    "npx *",
    "yarn install",
    "yarn run *",
    "pnpm install",
    "pnpm run *",
    // --- Python ---
    "python *",
    "python3 *",
    "pip install *",
    "pytest *",
    "flake8 *",
    "black *",
    "mypy *",
    // --- Bash / Shell ---
    "ls",
    "pwd",
    "echo *",
    "cat *",
    "tail *",
    "head *",
    "grep *",
    "find *",
    "chmod +x *",
    "chmod 644 *",
    "bash scripts/*.sh",
    "./scripts/*.sh"
  ]
}
